# PulsarPass environment example. Copy values per service or export them
# in your shell. Defaults match `make compose-up`.

# --- All services ---
APP_ENV=development
NATS_URL=nats://localhost:4222

# --- pulsar-gateway (:9091 health) ---
HTTP_ADDR=:8080
BUS_MODE=nats
# MAX_RESERVATION_QTY=8

# --- pulsar-core (:9092 health) ---
# DATABASE_URL=postgres://pulsar:pulsar@localhost:5432/pulsar_core?sslmode=disable
# RESERVATION_TTL=10m
# Redis fast-path for reservation holds. Shared with pulsar-chrono
# (hold cleanup). Set to empty to disable the accelerator; an
# unreachable Redis degrades gracefully — PostgreSQL stays authoritative.
REDIS_ADDR=localhost:6379

# --- pulsar-chrono (:9093 health) ---
# SWEEP_INTERVAL=5s
# SWEEP_BATCH=100
# REDIS_ADDR (shared with pulsar-core) — see pulsar-core section.

# --- pulsar-payment (:9094 health) ---
# SIMULATED_CHARGE_DELAY=250ms
# SIMULATED_FAILURE_RATE=0.05

# --- pulsar-horizon (:9095 health) ---
# POLL_INTERVAL=1s
# RELAY_BATCH=200
